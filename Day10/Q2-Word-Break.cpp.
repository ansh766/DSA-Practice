class Solution {
public:
    bool wordBreak(string s, vector<string>& wordDict) {
      int n  = wordDict.size();
      unordered_map<string,bool>m;
      for(int i= 0; i<n; i++){
         m[wordDict[i]] = 1;
      }    
      n = s.size();
    vector<int>curr(n+1,0);
    vector<int>fut(n+1,0);
    fut[n] = 1;
      for(int i= n-1; i>=0; i--){
        string ans = "";
         for(int j = i; j>=0; j--){
             ans+=s[j];
             reverse(ans.begin(),ans.end());
             int include = fut[j];
             int exclude = 0;
             if(m.count(ans)){
                 exclude =fut[i+1];
             }
            curr[j] = include|exclude;
             reverse(ans.begin(),ans.end());
         }
         fut = curr;
      }
      return curr[0];
    }
};
